{
  "name": "moonlight",
  "private": true,
  "workspaces": [
    "apps/moonlight-ui",
    "packages/npm/moonlight",
    "packages/npm/platforms/*"
  ],
  "scripts": {
    "prepare": "husky",
    "prepack": "echo 'This repository root is not publishable. Publish packages/npm/moonlight or packages/npm/platforms/* instead.' >&2; exit 1",
    "dev": "cd apps/moonlight-ui && bun run dev",
    "build": "cd apps/moonlight-ui && bun run build",
    "typegen": "bun scripts/generate-ui-api-types.mjs",
    "typegen:check": "bun scripts/generate-ui-api-types.mjs --check",
    "typecheck": "cd apps/moonlight-ui && bun run typecheck",
    "lint": "cargo clippy --workspace --all-targets -- -D warnings && bunx oxlint@1.80.0 apps/moonlight-ui packages/npm scripts --format=github",
    "test": "cd apps/moonlight-ui && bun run test",
    "test:run": "cd apps/moonlight-ui && bun run test:run",
    "test:agent-pages": "node apps/moonlight-ui/scripts/generate-agent-pages.mjs && node apps/moonlight-ui/scripts/check-agent-pages.mjs",
    "tdd:rust": "cargo test --workspace",
    "tdd:rust:cli": "cargo test -p moonlight-cli --test cli",
    "tdd:rust:core": "cargo test -p moonlight-core",
    "tdd:rust:http": "cargo test -p moonlight-http",
    "tdd:ui": "cd apps/moonlight-ui && bun run test",
    "tdd:ui:run": "cd apps/moonlight-ui && bun run test:run",
    "tdd:check": "cargo fmt --all -- --check && bun run lint && cargo test --workspace && bun run typegen:check && bun run typecheck && bun run test:run && bun run test:agent-pages",
    "agent:check": "bun run tdd:check && bun run build && bun run storybook:build",
    "agent:eval": "cargo run -p moonlight-cli --bin moonlight -- eval run --project moonlight.eval.toml --storage-path .moonlight/agent-runs.jsonl --format markdown",
    "agent:eval:report": "cargo run -p moonlight-cli --bin moonlight -- eval report --storage-path .moonlight/agent-runs.jsonl --format markdown",
    "storybook": "cd apps/moonlight-ui && bun run storybook",
    "storybook:build": "cd apps/moonlight-ui && bun run storybook:build",
    "benchmark:ui": "scripts/ui-unlighthouse.sh",
    "benchmark:ui:live": "scripts/ui-unlighthouse-live.sh"
  },
  "dependencies": {
    "playwright": "^1.62.1"
  },
  "overrides": {
    "vite": "^8.0.16"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,css}": "prettier --ignore-unknown --write",
    "*.rs": "sh -c 'cargo fmt --all'"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.4.4",
    "@storybook/react-vite": "^10.4.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.7",
    "storybook": "^10.4.4",
    "unlighthouse": "^0.17.10",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
