{
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "eslint/no-shadow": "off",
    "react/react-in-jsx-scope": "off",
    "react/rules-of-hooks": "error"
  },
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts", "**/*.spec.tsx"],
      "rules": {
        "eslint/no-unused-vars": "warn"
      }
    }
  ]
}
